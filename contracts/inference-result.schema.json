{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-farm.invalid/contracts/inference-result.schema.json",
  "title": "CountingJobResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "count",
    "detections",
    "warnings",
    "model_key",
    "model_version",
    "model_checksum",
    "adapter_version",
    "inference_source",
    "latency_ms"
  ],
  "properties": {
    "status": {"enum": ["succeeded", "review_required", "failed"]},
    "count": {"type": ["integer", "null"], "minimum": 0},
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "bbox", "confidence", "class_id"],
        "properties": {
          "asset_id": {"type": "string", "format": "uuid"},
          "bbox": {
            "type": "array",
            "prefixItems": [
              {"type": "number"},
              {"type": "number"},
              {"type": "number"},
              {"type": "number"}
            ],
            "minItems": 4,
            "maxItems": 4
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "class_id": {"type": "integer"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "model_key": {"type": "string"},
    "model_version": {"type": "string"},
    "model_checksum": {"type": "string"},
    "adapter_version": {"type": "string"},
    "inference_source": {"type": "string"},
    "latency_ms": {"type": "integer", "minimum": 0}
  }
}
