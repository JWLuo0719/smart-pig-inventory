{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-farm.invalid/contracts/inference-job.schema.json",
  "title": "CountingJobRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "correlation_id", "organization_id", "capture_set_id", "capture_kind", "media", "requested_model"],
  "properties": {
    "job_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "format": "uuid"},
    "capture_set_id": {"type": "string", "format": "uuid"},
    "capture_kind": {"enum": ["single", "left_center_right"]},
    "media": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "view_position", "object_uri", "sha256"],
        "properties": {
          "asset_id": {"type": "string", "format": "uuid"},
          "view_position": {"enum": ["single", "left", "center", "right"]},
          "object_uri": {"type": "string", "pattern": "^s3://"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "roi": {
            "type": ["object", "null"],
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": {"type": "number", "minimum": 0, "maximum": 1},
              "y": {"type": "number", "minimum": 0, "maximum": 1},
              "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "requested_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_key", "version", "checksum", "adapter_version"],
      "properties": {
        "model_key": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "checksum": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
