MYSQL_DATABASE=pig_inventory
MYSQL_USER=pig_inventory
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-minio-me
MINIO_BUCKET=pig-inventory

# Local identity values are generated by scripts/initialize-local-dev.ps1.
# Do not use blank values with SECURITY_ENABLED=true, and never commit real values.
SECURITY_ENABLED=false
# Comma-separated browser origins. Leave blank only for local native/mobile development.
CORS_ALLOWED_ORIGINS=http://localhost:8088
JWT_SIGNING_SECRET=
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=
APP_BOOTSTRAP_ORGANIZATION_CODE=
APP_BOOTSTRAP_ORGANIZATION_NAME=
# Local synthetic P0 fixtures only. initialize-local-dev.ps1 generates the password.
APP_E2E_FIXTURES_ENABLED=false
APP_E2E_FIXTURE_PASSWORD=

# 生产环境必须配置并启用 JWT；dev profile 仅限本机开发。
OIDC_ISSUER_URI=https://identity.example.invalid/realms/pig-inventory

# 只允许 unavailable、research-http-yolo（强制人工复核）或经验收的 http-yolo Provider 标识。
COUNTING_PROVIDER=unavailable
MODEL_KEY=pending-license-review
MODEL_VERSION=unverified
MODEL_CHECKSUM=unverified
MODEL_ADAPTER_VERSION=http-v1
INFERENCE_CALLBACK_TOKEN=
INFERENCE_DISPATCHER_ENABLED=false

# A separately licensed/approved model service may implement this provider contract.
# Do not point this at the bundled AGPL Ultralytics source without a licensing decision.
YOLO_HTTP_ENDPOINT=
# Enables only the isolated research adapter. It always returns review_required
# and is not a production approval signal.
MODEL_RESEARCH_ENABLED=false
MODEL_APPROVED=false
