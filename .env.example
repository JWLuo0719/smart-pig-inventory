MYSQL_DATABASE=pig_inventory
MYSQL_USER=pig_inventory
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-minio-me
MINIO_BUCKET=pig-inventory

# Local identity values are generated by scripts/initialize-local-dev.ps1.
# Do not use blank values with SECURITY_ENABLED=true, and never commit real values.
SECURITY_ENABLED=false
# Independent global monitoring access. Blank disables metrics access in ALL security modes.
# Generate a separate random secret locally; never reuse the callback/JWT secret.
MONITORING_SERVICE_KEY=
METRICS_SNAPSHOT_DELAY_MS=30000
# Comma-separated browser origins. Leave blank only for local native/mobile development.
CORS_ALLOWED_ORIGINS=http://localhost:8088
JWT_SIGNING_SECRET=
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=
APP_BOOTSTRAP_ORGANIZATION_CODE=
APP_BOOTSTRAP_ORGANIZATION_NAME=
# Local synthetic P0 fixtures only. initialize-local-dev.ps1 generates the password.
APP_E2E_FIXTURES_ENABLED=false
APP_E2E_FIXTURE_PASSWORD=

# 生产环境必须配置并启用 JWT；dev profile 仅限本机开发。
OIDC_ISSUER_URI=https://identity.example.invalid/realms/pig-inventory

# 只允许 unavailable、multi-view-dedup（三图跨图去重包装层）、research-http-yolo（强制人工复核）
# 或经验收的 http-yolo Provider 标识。
COUNTING_PROVIDER=unavailable
MODEL_KEY=pending-license-review
MODEL_VERSION=unverified
MODEL_CHECKSUM=unverified
MODEL_ADAPTER_VERSION=http-v1
# 三图（左/中/右）跨图去重：默认关闭。开启前必须先在现场标定相邻视图重叠比例，
# 且内层图像 Provider 仍需 MODEL_APPROVED（或研究模式）才会真正产生数量；
# 未标定或未批准时一律失败关闭为 review_required 且数量为空，绝不把三图简单相加。
MULTIVIEW_DEDUP_ENABLED=false
MULTIVIEW_VIEW_OVERLAP=
# 合并边界的现场标定值；Docker 下由 compose 以 ${VAR:-默认} 注入推理容器，
# 默认即推理侧 app/providers.py 的代码默认（0.08 / 0.35 / 1.0）。
MULTIVIEW_CENTER_TOLERANCE=0.08
MULTIVIEW_HEIGHT_TOLERANCE=0.35
MULTIVIEW_MAX_COST=1.0
# 三视图结果是否允许形成自动候选值（Spring 侧开关，默认 false：三图统一进入人工确认）。
MULTIVIEW_AUTO_COUNT_ENABLED=false
# 视频结果是否允许形成自动候选值（Spring 侧开关，默认 false：视频统一进入人工确认）。
# 它只解除服务端降级，真正产生数量还需要推理侧的 VIDEO_COUNTING_ENABLED 与已批准模型。
VIDEO_AUTO_COUNT_ENABLED=false
# 视频抽帧自动计数：默认关闭。抽帧与跨帧跟踪由产品仓库之外的 Runner 完成，产品侧只做
# 轨迹聚合与门禁；开启后仍需 MODEL_APPROVED（或研究模式）才会产生数量，缺少轨迹标识时
# 一律失败关闭为 review_required 且数量为空。
VIDEO_COUNTING_ENABLED=false
VIDEO_MIN_TRACK_OBSERVATIONS=1
# Required for every callback, even with SECURITY_ENABLED=false. Blank disables callback access.
INFERENCE_CALLBACK_TOKEN=
INFERENCE_DISPATCHER_ENABLED=false

# Confirmed-only PDF/XLSX export boundaries. The Compose default embeds Droid Sans Fallback.
REPORT_PDF_FONT_PATH=
REPORT_MAX_RANGE_DAYS=366
REPORT_MAX_RECORDS=10000

# A separately licensed/approved model service may implement this provider contract.
# Do not point this at the bundled AGPL Ultralytics source without a licensing decision.
YOLO_HTTP_ENDPOINT=
YOLO_HTTP_READY_ENDPOINT=
YOLO_HTTP_TIMEOUT_SECONDS=120
YOLO_HTTP_CONNECT_TIMEOUT_SECONDS=10
# 外部 Runner（pig-farm-agent/research_runner）可选共享令牌 RUNNER_API_TOKEN：
# Runner 侧设置后，其 /count 与 /ready 要求请求头 X-Runner-Service-Key 与之匹配；
# 未设置则不校验（默认关闭，适合仅回环/内网部署）。
# Enables only the isolated research adapter. It always returns review_required
# and is not a production approval signal.
MODEL_RESEARCH_ENABLED=false
MODEL_APPROVED=false
